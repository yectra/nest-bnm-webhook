PORT=3000
NODE_ENV=development

# Azure OpenAI: use the Azure OpenAI v1 base URL. EMBEDDING_MODEL is the
# deployed model name, which may differ from text-embedding-3-small.
OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1/
OPENAI_API_KEY=replace-with-azure-openai-key
OPENAI_MODEL=replace-with-chat-deployment-name
EMBEDDING_MODEL=replace-with-embedding-deployment-name
EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=30000
EMBEDDED_DOCUMENTS_CONTAINER=EmbeddedDocuments
EMBEDDED_DOCUMENTS_PARTITION_KEY=/id
CHATBOT_VECTOR_TOP_K=5
CHATBOT_VECTOR_MIN_SIMILARITY=0.7

# LangGraph agent crew. AGENT_CREW_MODEL is the GPT-5 deployment name on
# Azure AI Foundry (falls back to OPENAI_MODEL when unset).
AGENT_CREW_MODEL=replace-with-gpt-5-deployment-name
AGENT_CREW_TOP_K=5
# Picture analysis (GPT-5 vision) is disabled by default; set to true to
# let the crew analyze pictures on quotes and requirement forms.
AGENT_CREW_IMAGE_AGENT_ENABLED=false
AGENT_CREW_MAX_IMAGES=4
AGENT_CREW_QUOTE_CONTAINER=Quote
AGENT_CREW_REQUIREMENTS_CONTAINER=PostYourRequirements
AGENT_CREW_PII_LLM_REVIEW=true

# Prompt-injection guard. The RAG index of known injection messages lives in
# PROMPT_GUARD_CONTAINER, embedded with the EMBEDDING_MODEL deployment
# (text-embedding-3-small). Seed it with:
#   POST /api/prompt-guard/signatures/seed   (header: x-api-key)
PROMPT_GUARD_CONTAINER=PromptInjectionSignatures
PROMPT_GUARD_TOP_K=8
PROMPT_GUARD_MIN_SIMILARITY=0.45
PROMPT_GUARD_HIGH_SIMILARITY=0.86
PROMPT_GUARD_DECISION_THRESHOLD=0.6
PROMPT_GUARD_JUDGE_BAND=0.18
# GPT-5 judge runs only when retrieval and the pattern scan are inconclusive.
PROMPT_GUARD_LLM_JUDGE=true
PROMPT_GUARD_MODEL=replace-with-gpt-5-deployment-name
# Seed the vector index at boot instead of through the admin endpoint.
PROMPT_GUARD_AUTO_SEED=false
PROMPT_GUARD_MAX_INPUT_CHARS=8000
# Extra event payload fields to read the inspected text from, checked first.
PROMPT_GUARD_EVENT_TEXT_FIELDS=

COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=replace-with-cosmos-key
COSMOS_DATABASE=replace-with-database-name

# Required in production and for /api/embeddings/* administrative operations.
API_KEY=replace-with-a-random-32-character-minimum-secret

TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
