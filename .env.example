PORT=port

NODE_ENV=development

# TWILIO VALUES
TWILIO_ACCOUNT_SID=<twilio-account-sid>

TWILIO_AUTH_TOKEN=<twilio-auth-token>

TWILIO_WHATSAPP_NUMBER=<twilio-whatsapp-number>

# OPENAI VALUES
OPENAI_BASE_URL=<openai-base-url>

OPENAI_API_KEY=<openai-api-key>

OPENAI_MODEL=<openai-model>

EMBEDDING_MODEL=<embedding-model-name>

# COSMOS VALUES
COSMOS_ENDPOINT=<cosmos-enpoint-url>

COSMOS_KEY=<cosmos-key>

COSMOS_DATABASE=<cosmos-database-name>

# POSTAPI - API KEY
API_KEY=bnm-local-admin-key-please-change-123456

EMBEDDED_DOCUMENTS_CONTAINER=EmbeddedDocuments

CHATBOT_VECTOR_TOP_K=5

CHATBOT_VECTOR_MIN_SIMILARITY=0.7

# MICROSOFT FABRIC 
FABRIC_TENANT_ID=YOUR-AZURE-AD-TENANT-GUID

FABRIC_CLIENT_ID=YOUR-APP-REGISTRATION-CLIENT-ID

FABRIC_CLIENT_SECRET=YOUR-APP-REGISTRATION-CLIENT-SECRET

FABRIC_WORKSPACE_ID=YOUR-FABRIC-WORKSPACE-ID

FABRIC_GRAPHQL_API_ID=YOUR-FABRIC-GRAPHQL-API-ID

FABRIC_GRAPH_MODEL_ID=YOUR-FABRIC-GRAPH-MODEL-ID

# optional overrides
FABRIC_API_BASE_URL=https://api.fabric.microsoft.com/v1

FABRIC_SCOPE=https://analysis.windows.net/powerbi/api/.default

