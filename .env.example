PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Azure AD B2C. Every API route requires an access token from this tenant's
# user flow, so the app refuses to start without these three values.
# ---------------------------------------------------------------------------
# Tenant short name: the "contoso" in contoso.b2clogin.com.
AZURE_B2C_TENANT_NAME=replace-with-b2c-tenant-name
# Sign-up/sign-in user flow or custom policy that issues the access tokens.
AZURE_B2C_POLICY=B2C_1_signupsignin
# Application (client) ID of THIS API's B2C app registration. Access tokens
# are accepted only when their aud claim matches it.
AZURE_B2C_CLIENT_ID=replace-with-api-application-client-id

# Optional. Scopes every request must carry, comma separated. Set this to the
# scope you exposed on the API registration; it also stops a token minted for
# a different purpose in the same tenant from being reused here.
# AZURE_B2C_REQUIRED_SCOPES=api.access
# Extra accepted audiences, for clients still on a previous registration.
# AZURE_B2C_AUDIENCE=
# Only for a B2C custom domain or a non-default cloud.
# AZURE_B2C_INSTANCE=https://login.example.com
# Directory the user flow lives in. Defaults to <tenant>.onmicrosoft.com.
# AZURE_B2C_TENANT_DOMAIN=contoso.onmicrosoft.com
# Full OIDC metadata URL; overrides the one derived from the values above.
# AZURE_B2C_DISCOVERY_URL=
# Only for tenants whose iss claim cannot be read from discovery.
# AZURE_B2C_ISSUER=
# Tolerated clock drift, and how long metadata and signing keys are cached.
# AZURE_B2C_CLOCK_SKEW_SECONDS=60
# AZURE_B2C_JWKS_CACHE_MS=600000
# AZURE_B2C_DISCOVERY_CACHE_MS=43200000

# Azure OpenAI: use the Azure OpenAI v1 base URL. EMBEDDING_MODEL is the
# deployed model name, which may differ from text-embedding-3-small.
OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1/
OPENAI_API_KEY=replace-with-azure-openai-key
OPENAI_MODEL=replace-with-chat-deployment-name
EMBEDDING_MODEL=replace-with-embedding-deployment-name
EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=30000
EMBEDDED_DOCUMENTS_CONTAINER=EmbeddedDocuments
EMBEDDED_DOCUMENTS_PARTITION_KEY=/id
CHATBOT_VECTOR_TOP_K=5
CHATBOT_VECTOR_MIN_SIMILARITY=0.7

# LangGraph agent crew. AGENT_CREW_MODEL is the GPT-5 deployment name on
# Azure AI Foundry (falls back to OPENAI_MODEL when unset).
AGENT_CREW_MODEL=replace-with-gpt-5-deployment-name
AGENT_CREW_TOP_K=5
# Picture analysis (GPT-5 vision) is disabled by default; set to true to
# let the crew analyze pictures on quotes and requirement forms.
AGENT_CREW_IMAGE_AGENT_ENABLED=false
AGENT_CREW_MAX_IMAGES=4
AGENT_CREW_QUOTE_CONTAINER=Quote
AGENT_CREW_REQUIREMENTS_CONTAINER=PostYourRequirements
AGENT_CREW_PII_LLM_REVIEW=true

# LangSmith tracing for the WhatsApp deep agent. Tracing is OFF unless
# LANGSMITH_API_KEY is set: with no key nothing is sent to LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bnm-hello-agent
# Only for self-hosted or EU LangSmith deployments.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Kill switch: set to false to stop tracing without removing the key.
# LANGSMITH_TRACING=true
# Upload each run's trace before the reply returns instead of batching it in
# the background. Costs a LangSmith round trip per run; use it on hosts that
# may not stay alive long enough to drain the queue.
# LANGSMITH_FLUSH_AFTER_RUN=false

COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=replace-with-cosmos-key
COSMOS_DATABASE=replace-with-database-name

# Required in production and for /api/embeddings/* administrative operations.
API_KEY=replace-with-a-random-32-character-minimum-secret

TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# Azure Key Vault URL
AZURE_KEYVAULT_URL=https://bricknmortar-kv-dev.vault.azure.net/

# Secret Name in Key Vault (Optional - defaults to 'event-capture-security-key')
AZURE_KEYVAULT_SECRET_NAME=event-capture-security-key
